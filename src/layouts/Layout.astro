---
import '../styles/global.css';
import { portfolioData } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
}

const { personal } = portfolioData;

const { 
  title = `${personal.name} — Editorial Writer, Researcher & Strategist`,
  description = personal.summary
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chahat Singh Editorial Portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- High-Performance Typography Preconnects -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500;1,6..72,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body>
    <!-- Top Reading Progress Line -->
    <div id="reading-progress" aria-hidden="true"></div>

    <!-- Minimalist Gallery Header Bar (Inspired by Kuulikki Icon Directory) -->
    <header class="gallery-nav-bar">
      <div class="nav-content">
        <a href="#" class="brand-signature">
          <span class="brand-monogram">CS</span>
          <span class="brand-name">{personal.name}</span>
          <span class="brand-tag">/ Editorial & Research Portfolio</span>
        </a>

        <!-- Desktop Icon Directory & Navigation Links -->
        <nav class="gallery-icon-directory desktop-nav" aria-label="Quick Directory">
          <a href="#films" title="Directed Short Films" class="dir-icon-link">🎬</a>
          <a href="#channels" title="Publication Channels" class="dir-icon-link">📸</a>
          <a href="#properties" title="Editorial Portfolios" class="dir-icon-link">🏛️</a>
          <a href="#samples" title="Writing Samples" class="dir-icon-link">📖</a>
          <a href="#strategy" title="Content Strategy" class="dir-icon-link">⚡</a>
          <a href="#philosophy" title="Editorial Philosophy" class="dir-icon-link">📜</a>
          <a href="#experience" title="Newsroom Background" class="dir-icon-link">📰</a>
          <span class="dir-sep">/</span>
          <a href="https://boxd.it/4hAfn" target="_blank" rel="noopener noreferrer" class="text-dir-link" title="Letterboxd Profile">boxd</a>
          <a href="https://vimeo.com/user214567561?fl=pp&fe=sh" target="_blank" rel="noopener noreferrer" class="text-dir-link" title="Vimeo Channel">vimeo</a>
          <a href="https://www.instagram.com/chahatnotebook?stkn=aHl1bWRlNWw4aW1j" target="_blank" rel="noopener noreferrer" class="text-dir-link" title="Instagram @chahatnotebook">insta</a>
          <a href="#contact" class="text-dir-link contact-pill">contact</a>
          
          <!-- Luxury Theme Toggle Button -->
          <button id="theme-toggle-btn" class="theme-switch-btn" aria-label="Toggle gallery lighting" title="Toggle Gallery Theme">
            <span class="theme-icon" id="theme-icon">◐</span>
          </button>
        </nav>

        <!-- Mobile Header Controls -->
        <div class="mobile-nav-controls">
          <button id="theme-toggle-btn-mobile" class="theme-switch-btn" aria-label="Toggle theme">
            <span class="theme-icon-mobile">◐</span>
          </button>
          <button id="mobile-menu-btn" class="mobile-menu-toggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Fullscreen Mobile Navigation Drawer -->
    <div id="mobile-drawer" class="mobile-drawer-overlay" aria-hidden="true">
      <div class="mobile-drawer-content">
        <div class="drawer-header">
          <span class="drawer-title">EXHIBITS & DIRECTORY</span>
          <button id="drawer-close-btn" class="drawer-close" aria-label="Close Navigation">✕</button>
        </div>

        <nav class="drawer-links" aria-label="Mobile Navigation">
          <a href="#films" class="drawer-link-item">
            <span class="drawer-icon">🎬</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Directed Short Films</span>
              <span class="drawer-link-sub">Cinema & Screenwriting</span>
            </div>
          </a>
          <a href="#channels" class="drawer-link-item">
            <span class="drawer-icon">📸</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Publication Channels</span>
              <span class="drawer-link-sub">10 Active Portfolios • 2M+ Reach</span>
            </div>
          </a>
          <a href="#properties" class="drawer-link-item">
            <span class="drawer-icon">🏛️</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Editorial Monograph</span>
              <span class="drawer-link-sub">Ten Research Niches</span>
            </div>
          </a>
          <a href="#samples" class="drawer-link-item">
            <span class="drawer-icon">📖</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Writing Samples & Essays</span>
              <span class="drawer-link-sub">Hook Architecture & Analysis</span>
            </div>
          </a>
          <a href="#strategy" class="drawer-link-item">
            <span class="drawer-icon">⚡</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Content Strategy</span>
              <span class="drawer-link-sub">6-Step Viral Narrative Flow</span>
            </div>
          </a>
          <a href="#philosophy" class="drawer-link-item">
            <span class="drawer-icon">📜</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Editorial Philosophy</span>
              <span class="drawer-link-sub">Causal Continuity & Rigor</span>
            </div>
          </a>
          <a href="#experience" class="drawer-link-item">
            <span class="drawer-icon">📰</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Newsroom Dossier</span>
              <span class="drawer-link-sub">3D Incident & Research Background</span>
            </div>
          </a>
          <a href="#contact" class="drawer-link-item drawer-contact-highlight">
            <span class="drawer-icon">✉️</span>
            <div class="drawer-text-group">
              <span class="drawer-link-title">Inquiries & Commissions</span>
              <span class="drawer-link-sub">{personal.email}</span>
            </div>
          </a>
        </nav>

        <div class="drawer-footer">
          <div class="drawer-socials-row">
            <a href="https://boxd.it/4hAfn" target="_blank" rel="noopener noreferrer" class="drawer-social-pill">Letterboxd ↗</a>
            <a href="https://vimeo.com/user214567561?fl=pp&fe=sh" target="_blank" rel="noopener noreferrer" class="drawer-social-pill">Vimeo ↗</a>
            <a href="https://www.instagram.com/chahatnotebook?stkn=aHl1bWRlNWw4aW1j" target="_blank" rel="noopener noreferrer" class="drawer-social-pill">Instagram ↗</a>
            <a href={personal.whatsapp} target="_blank" rel="noopener noreferrer" class="drawer-social-pill wa-pill">WhatsApp ↗</a>
          </div>
        </div>
      </div>
    </div>

    <div class="gallery-container">
      <slot />
    </div>

    <!-- Theme Switch & Mobile Drawer Scripts -->
    <script>
      function initGalleryCore() {
        // Scroll Progress
        const progressBar = document.getElementById('reading-progress');
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (progressBar) {
                const winScroll = window.scrollY;
                const height = document.documentElement.scrollHeight - window.innerHeight;
                const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
                progressBar.style.width = `${scrolled}%`;
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Theme Toggle
        const themeBtn = document.getElementById('theme-toggle-btn');
        const themeBtnMobile = document.getElementById('theme-toggle-btn-mobile');
        const themeIcon = document.getElementById('theme-icon');
        const themeIconMobile = document.querySelector('.theme-icon-mobile');
        const html = document.documentElement;

        function applyTheme(theme: string) {
          html.setAttribute('data-theme', theme);
          localStorage.setItem('gallery-theme', theme);
          const icon = theme === 'dark' ? '☀️' : '◐';
          if (themeIcon) themeIcon.textContent = icon;
          if (themeIconMobile) themeIconMobile.textContent = icon;
        }

        const savedTheme = localStorage.getItem('gallery-theme') || 'light';
        applyTheme(savedTheme);

        function toggleTheme() {
          const current = html.getAttribute('data-theme') || 'light';
          applyTheme(current === 'light' ? 'dark' : 'light');
        }

        if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
        if (themeBtnMobile) themeBtnMobile.addEventListener('click', toggleTheme);

        // Mobile Drawer Toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        const closeBtn = document.getElementById('drawer-close-btn');
        const drawerLinks = document.querySelectorAll<HTMLAnchorElement>('.drawer-link-item, .drawer-social-pill');

        function openDrawer() {
          if (drawer) {
            drawer.classList.add('active');
            drawer.setAttribute('aria-hidden', 'false');
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeDrawer() {
          if (drawer) {
            drawer.classList.remove('active');
            drawer.setAttribute('aria-hidden', 'true');
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          }
        }

        if (menuBtn) menuBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

        drawerLinks.forEach(link => {
          link.addEventListener('click', () => {
            closeDrawer();
          });
        });

        if (drawer) {
          drawer.addEventListener('click', (e) => {
            if (e.target === drawer) closeDrawer();
          });
        }
      }

      initGalleryCore();
    </script>
  </body>
</html>

<style>
  .gallery-nav-bar {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: var(--bg-page);
    border-bottom: 1px solid var(--hairline);
    transition: background-color var(--speed-normal) var(--ease), border-color var(--speed-normal) var(--ease);
  }

  .nav-content {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0.75rem clamp(1rem, 3.5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-signature {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    color: var(--text-main);
    flex-shrink: 0;
  }

  .brand-monogram {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-terracotta);
    letter-spacing: -0.05em;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  /* Desktop Icon Directory */
  .gallery-icon-directory {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .dir-icon-link {
    font-size: 0.95rem;
    padding: 0.2rem 0.3rem;
    border-radius: 2px;
    transition: transform var(--speed-fast) var(--ease), opacity var(--speed-fast) var(--ease);
    opacity: 0.85;
  }

  .dir-icon-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .dir-sep {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .text-dir-link {
    font-family: var(--font-sans);
    font-size: 0.825rem;
    color: var(--text-secondary);
    font-weight: 500;
    padding: 0.2rem 0.4rem;
    transition: color var(--speed-fast) var(--ease);
  }

  .text-dir-link:hover {
    color: var(--text-main);
    text-decoration: underline;
  }

  .contact-pill {
    background: var(--text-main);
    color: var(--bg-page) !important;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.775rem;
    text-decoration: none !important;
    transition: background var(--speed-fast) var(--ease);
  }

  .contact-pill:hover {
    background: var(--accent-terracotta);
  }

  .theme-switch-btn {
    background: transparent;
    border: 1px solid var(--hairline);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-main);
    font-size: 0.85rem;
    transition: all var(--speed-fast) var(--ease);
  }

  .theme-switch-btn:hover {
    border-color: var(--text-main);
    transform: rotate(45deg);
  }

  /* Mobile Controls */
  .mobile-nav-controls {
    display: none;
    align-items: center;
    gap: 0.6rem;
  }

  .mobile-menu-toggle {
    width: 36px;
    height: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    cursor: pointer;
    padding: 0;
    color: var(--text-main);
  }

  .hamburger-bar {
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: all var(--speed-fast) var(--ease);
  }

  /* Mobile Drawer */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--speed-normal) var(--ease);
    display: flex;
    justify-content: flex-end;
  }

  .mobile-drawer-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer-content {
    background: var(--bg-page);
    width: 88%;
    max-width: 380px;
    height: 100%;
    overflow-y: auto;
    padding: 1.5rem 1.25rem 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: transform var(--speed-normal) var(--ease);
  }

  .mobile-drawer-overlay.active .mobile-drawer-content {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 1rem;
  }

  .drawer-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-terracotta);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .drawer-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .drawer-link-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: all var(--speed-fast) var(--ease);
  }

  .drawer-link-item:hover, .drawer-link-item:active {
    background: var(--bg-surface-soft);
    border-color: var(--hairline);
  }

  .drawer-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .drawer-text-group {
    display: flex;
    flex-direction: column;
  }

  .drawer-link-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .drawer-link-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .drawer-contact-highlight {
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    margin-top: 0.5rem;
  }

  .drawer-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    margin-top: 1.5rem;
  }

  .drawer-socials-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .drawer-social-pill {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    color: var(--text-secondary);
  }

  .wa-pill {
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.08);
  }

  @media (max-width: 960px) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav-controls {
      display: flex;
    }

    .brand-tag {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .nav-content {
      padding: 0.65rem 1rem;
    }

    .brand-name {
      font-size: 1.05rem;
    }
  }
</style>
