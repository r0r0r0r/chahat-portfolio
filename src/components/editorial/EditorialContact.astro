---
import { portfolioData } from '../../data/portfolioData';

const { personal, socials } = portfolioData;

const projectScopes = [
  'Brand Case Study',
  'Historical Deep Dive',
  'News & Policy Explainer',
  'Commercial Copywriting & Hooks',
  'Content Strategy & Retainer',
  'Full-Time / Contract Role'
];
---

<section class="gallery-section" id="contact">
  <div class="section-number-tag">
    <span>EXHIBIT 07 // COMMISSIONS & INQUIRIES</span>
  </div>
  <h2 class="section-title">
    Let's Build Your Next <span class="italic-serif">High-Impact Publication</span>
  </h2>
  <p class="section-subtext">
    Available for full-time editorial roles, freelance commissions, brand case study research, and high-retention content strategy consulting.
  </p>

  <div class="gallery-card contact-card">
    <!-- Left Column: Direct Inquiries & Channels -->
    <div class="contact-left">
      <div>
        <div class="contact-status-pill">
          <span class="pulse-dot"></span>
          <span>Open for Opportunities // 2026</span>
        </div>
        <h3 class="contact-card-title">Direct Editorial Salon</h3>
        <p class="contact-card-text">
          Whether you are an editor looking for relentlessly researched stories, a brand building a distinctive publication, or a digital agency scaling retention-first media, let's collaborate.
        </p>
      </div>

      <!-- Quick Copy & Action Boxes -->
      <div class="direct-channels-stack">
        <!-- Email Box -->
        <div class="channel-action-item">
          <span class="action-label">DIRECT EMAIL ADDRESS</span>
          <button id="copy-email-btn" class="copy-channel-btn" data-email={personal.email} title="Click to copy email address">
            <span class="channel-val-text">{personal.email}</span>
            <span class="copy-status-badge" id="copy-badge">📋 COPY EMAIL</span>
          </button>
        </div>

        <!-- Phone & WhatsApp Box -->
        <div class="channel-action-item">
          <span class="action-label">DIRECT PHONE / WHATSAPP</span>
          <div class="phone-action-row">
            <a href={`tel:${personal.phoneRaw}`} class="phone-call-btn" title="Call directly">
              <span>📞 {personal.phone}</span>
            </a>
            <a href={personal.whatsapp} target="_blank" rel="noopener noreferrer" class="whatsapp-btn" title="Chat on WhatsApp">
              <span>💬 WhatsApp ↗</span>
            </a>
          </div>
        </div>

        <!-- Location Badge -->
        <div class="location-badge-box">
          <span class="action-label">EDITORIAL BASE & AVAILABILITY</span>
          <span class="location-text">📍 {personal.location}</span>
        </div>
      </div>

      <!-- Response Guarantee -->
      <div class="sla-badge">
        <span class="sla-icon">⏱️</span>
        <span class="sla-text">Guaranteed response turnaround within 24 hours</span>
      </div>

      <!-- Social Channels Directory -->
      <div class="social-directory">
        <span class="social-header-label">PUBLICATIONS & NETWORKS</span>
        {socials.filter(s => s.label !== 'Email' && s.label !== 'Phone / WhatsApp').map(social => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-directory-item">
            <span class="social-platform">{social.label}</span>
            <span class="social-handle-val">
              <span>{social.handle}</span>
              <span class="arrow">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Right Column: Interactive Inquiry Form with Project Scope Chips -->
    <div class="contact-right">
      <form id="editorial-form" class="editorial-form">
        <div class="scope-selector-group">
          <label class="field-label">SELECT PROJECT SCOPE OR NICHE:</label>
          <div class="scope-chips" id="scope-chips">
            {projectScopes.map(scope => (
              <button type="button" class="scope-chip" data-scope={scope}>
                <span>{scope}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="form-name" class="field-label">Your Name / Publication</label>
            <input type="text" id="form-name" placeholder="e.g. Elena Vance / Editorial Dept." required />
          </div>
          <div class="form-field">
            <label for="form-email" class="field-label">Email Address</label>
            <input type="email" id="form-email" placeholder="elena@publication.com" required />
          </div>
        </div>

        <div class="form-field">
          <label for="form-topic" class="field-label">Project Focus / Subject Line</label>
          <input type="text" id="form-topic" placeholder="e.g. Brand Case Study / Historical Video Script Series" required />
        </div>

        <div class="form-field">
          <label for="form-msg" class="field-label">Brief Details & Desired Timeline</label>
          <textarea id="form-msg" rows="4" placeholder="Describe the topic, publication format, audience persona, or target turnaround..." required></textarea>
        </div>

        <button type="submit" class="btn-gallery btn-gallery-primary submit-btn" id="submit-btn">
          <span>Transmit Editorial Brief</span>
          <span>→</span>
        </button>

        <div id="form-feedback" class="form-feedback" style="display: none;"></div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-card {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    padding: 3rem;
  }

  .contact-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .contact-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-secondary);
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
  }

  .contact-card-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .contact-card-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .direct-channels-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .channel-action-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .action-label {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  .copy-channel-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.15rem;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    cursor: pointer;
    transition: all var(--speed-fast) var(--ease);
  }

  .copy-channel-btn:hover {
    border-color: var(--text-main);
  }

  .channel-val-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-main);
    word-break: break-all;
  }

  .copy-status-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-terracotta);
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    transition: all var(--speed-fast) var(--ease);
  }

  .copy-channel-btn.copied .copy-status-badge {
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.1);
  }

  .phone-action-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .phone-call-btn,
  .whatsapp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: all var(--speed-fast) var(--ease);
    border: 1px solid var(--hairline);
  }

  .phone-call-btn {
    background: var(--bg-surface-soft);
    color: var(--text-main);
  }

  .phone-call-btn:hover {
    border-color: var(--text-main);
  }

  .whatsapp-btn {
    background: rgba(16, 185, 129, 0.08);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .whatsapp-btn:hover {
    background: #10b981;
    color: #ffffff;
  }

  .location-badge-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.75rem 1rem;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    border-radius: 4px;
  }

  .location-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .sla-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-muted);
    background: var(--bg-surface-soft);
    padding: 0.6rem 0.9rem;
    border-radius: 4px;
    border: 1px solid var(--hairline-subtle);
  }

  .sla-icon {
    font-size: 0.85rem;
  }

  .social-directory {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline-subtle);
  }

  .social-header-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .social-directory-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.88rem;
    padding: 0.35rem 0;
    transition: all var(--speed-fast) var(--ease);
  }

  .social-platform {
    color: var(--text-main);
    font-weight: 500;
  }

  .social-handle-val {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .social-directory-item:hover .social-handle-val {
    color: var(--accent-terracotta);
    transform: translateX(2px);
  }

  /* Form Styling */
  .editorial-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .scope-selector-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .scope-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .scope-chip {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-muted);
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--speed-fast) var(--ease);
  }

  .scope-chip:hover {
    color: var(--text-main);
    border-color: var(--text-main);
  }

  .scope-chip.selected {
    background: var(--text-main);
    color: var(--bg-page);
    border-color: var(--text-main);
    font-weight: 600;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-field input,
  .form-field textarea {
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 0.85rem 1.15rem;
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--speed-fast) var(--ease);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--accent-terracotta);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-faint);
    opacity: 0.7;
  }

  .submit-btn {
    width: 100%;
    margin-top: 0.5rem;
    padding: 1rem 1.75rem;
    font-size: 0.95rem;
    cursor: pointer;
    justify-content: center;
  }

  .form-feedback {
    font-size: 0.9rem;
    color: #10b981;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 1rem;
    border-radius: 4px;
    text-align: center;
    line-height: 1.5;
  }

  /* Mobile Responsiveness */
  @media (max-width: 960px) {
    .contact-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2.5rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contact-card {
      padding: 1.25rem 1rem;
      gap: 2rem;
    }

    .contact-card-title {
      font-size: 1.45rem;
    }

    .scope-chips {
      gap: 0.4rem;
    }

    .scope-chip {
      padding: 0.4rem 0.65rem;
      font-size: 0.725rem;
    }

    .phone-action-row {
      grid-template-columns: 1fr;
    }

    .phone-call-btn, .whatsapp-btn {
      padding: 0.75rem 1rem;
    }

    .copy-channel-btn {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.85rem 1rem;
    }

    .submit-btn {
      padding: 0.95rem 1.25rem;
    }
  }
</style>

<script>
  function initContact() {
    // 1-Click Email Copy
    const copyBtn = document.getElementById('copy-email-btn');
    const copyBadge = document.getElementById('copy-badge');

    if (copyBtn && copyBadge) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || '';
        try {
          await navigator.clipboard.writeText(email);
          copyBadge.textContent = '✓ COPIED!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBadge.textContent = '📋 COPY EMAIL';
            copyBtn.classList.remove('copied');
          }, 2500);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }

    // Project Scope Selector Chips
    const scopeChips = document.querySelectorAll<HTMLButtonElement>('.scope-chip');
    const topicInput = document.getElementById('form-topic') as HTMLInputElement;

    scopeChips.forEach(chip => {
      chip.addEventListener('click', () => {
        scopeChips.forEach(c => c.classList.remove('selected'));
        chip.classList.add('selected');
        const scopeVal = chip.getAttribute('data-scope');
        if (topicInput && scopeVal) {
          topicInput.value = scopeVal;
        }
      });
    });

    // Form Submission
    const form = document.getElementById('editorial-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn');
    const feedback = document.getElementById('form-feedback');

    if (form && submitBtn && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = '<span>Transmitting Brief...</span>';

        setTimeout(() => {
          feedback.textContent = '✓ Inquiry received. I will review your project brief and respond within 24 hours.';
          feedback.style.display = 'block';
          form.reset();
          scopeChips.forEach(c => c.classList.remove('selected'));
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = '<span>Transmit Editorial Brief</span> <span>→</span>';
          setTimeout(() => { feedback.style.display = 'none'; }, 7000);
        }, 600);
      });
    }
  }

  initContact();
</script>
