---
import { portfolioData } from '../../data/portfolioData';
import { getAssetUrl } from '../../utils/assets';

const { experience, coreSkills, growthTrackRecord, personal } = portfolioData;
const exp = experience[0];
---

<section class="gallery-section" id="experience">
  <div class="gallery-section-header">
    <span class="section-number-tag">06 // NEWSROOM DOSSIER & GROWTH RECORD</span>
    <h2 class="section-title">
      Newsroom Cadence & <span class="italic-serif">Audience Traction</span>
    </h2>
    <p class="section-subtext">
      Practical newsroom training under tight turnaround deadlines combined with academic mass media rigor and proven viral distribution across 10 specialized media channels.
    </p>
  </div>

  <!-- Education & Newsroom Monograph Hero -->
  <div class="gallery-card newsroom-hero">
    <div class="newsroom-hero-grid">
      <!-- Left Column: Author Studio Portrait -->
      <div class="author-portrait-column">
        <div class="author-portrait-frame">
          <img 
            src={getAssetUrl('/assets/images/chahat_singh.jpg')} 
            alt="Chahat Singh — Filmmaker & Researcher at studio desk" 
            class="author-portrait-img"
            loading="lazy"
            decoding="async"
            width="600"
            height="750"
          />
          <div class="portrait-meta-overlay">
            <div class="now-playing-pill">
              <span class="music-bars-anim" aria-hidden="true">
                <span class="bar b1"></span>
                <span class="bar b2"></span>
                <span class="bar b3"></span>
              </span>
              <span>How? — John Lennon</span>
            </div>
            <div class="author-badge-card">
              <span class="author-name-tag">{personal.name}</span>
              <span class="author-sub-tag">BMM Graduate • Filmmaker & Researcher</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Newsroom Dossier & Methods -->
      <div class="newsroom-content-column">
        <div class="newsroom-header-row">
          <div class="org-meta-block">
            <span class="news-duration-badge">ACADEMIC FOUNDATION // {personal.education}</span>
            <h3 class="news-role-title">Filmmaker, Screenwriter & Newsroom Researcher</h3>
            <span class="news-org-name">{exp.organization} • Digital News Desk</span>
          </div>
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span>Newsroom & 3D Incident Trained</span>
          </div>
        </div>

        <p class="news-desc">
          {personal.educationDetail} Combined with hands-on newsroom desk experience, this foundation enables taking raw breaking incidents, historical archives, and corporate balance sheets through the entire production pipeline.
        </p>

        <!-- Speed vs Accuracy Balance Monograph -->
        <div class="cadence-box">
          <div class="cadence-header">
            <span class="cadence-label">THE 3D INCIDENT & INVESTIGATIVE METHOD</span>
          </div>
          <p class="cadence-text">
            Working on 3D incident-based videos (@indiainlast24hr) and breaking city news (@bombay) requires extreme factual precision: researching timelines, murder and crime cases, primary evidence, GPS locations, and the exact sequence of events so complex stories can be visualized in 3D and understood effortlessly by millions.
          </p>
        </div>

        <!-- Competencies Grid -->
        <div class="competencies-wrapper">
          <span class="competencies-heading">VERIFIED NEWSROOM PROTOCOLS</span>
          <div class="competencies-grid">
            {exp.learnings.map(item => (
              <div class="competency-card">
                <span class="comp-icon">✦</span>
                <span class="comp-text">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Growth Milestones Bento Grid -->
  <div class="growth-wrapper">
    <div class="growth-header">
      <span class="growth-eyebrow">PROVEN PERFORMANCE METRICS</span>
      <h3 class="growth-heading">Growth Milestones Across 10 Digital Properties</h3>
      <p class="growth-sub">
        Demonstrated understanding of audience response across news, regional history, Bollywood cinema, corporate brands, and finance:
      </p>
    </div>

    <div class="growth-grid">
      {growthTrackRecord.map(item => (
        <div class="gallery-card growth-card">
          <div class="growth-top">
            <span class="growth-channel">{item.channel}</span>
            <span class="growth-badge">{item.timeframe}</span>
          </div>
          <div class="growth-metric-val">{item.metric}</div>
          <div class="growth-role">{item.role}</div>
          <p class="growth-desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Specialization Areas Gallery Bento Grid -->
  <div class="specializations-wrapper">
    <div class="spec-header">
      <span class="spec-eyebrow">SPECIALIZED COMPETENCIES</span>
      <h3 class="spec-heading">Seven Core Capability Pillars</h3>
    </div>

    <div class="skills-bento-grid">
      {coreSkills.map(skill => (
        <div class="gallery-card skill-bento-card">
          <div class="skill-card-top">
            <h4 class="skill-title">{skill.name}</h4>
            <span class="skill-type-tag">{skill.type}</span>
          </div>

          <p class="skill-description">{skill.description}</p>

          {skill.tags && (
            <div class="skill-tags-row">
              {skill.tags.map(t => (
                <span class="skill-chip">{t}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .newsroom-hero {
    padding: 2.5rem;
    margin-bottom: 4rem;
    background: var(--bg-surface);
  }

  .newsroom-hero-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .author-portrait-column {
    display: flex;
    flex-direction: column;
  }

  .author-portrait-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--bg-surface-soft);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    aspect-ratio: 4 / 4.8;
  }

  .author-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: contrast(1.04) brightness(0.98);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .author-portrait-frame:hover .author-portrait-img {
    transform: scale(1.03);
  }

  .portrait-meta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(10,12,18,0.85) 100%);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .now-playing-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 19, 26, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.675rem;
    color: #ffffff;
  }

  .music-bars-anim {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .music-bars-anim .bar {
    width: 2px;
    background: var(--accent-terracotta);
    border-radius: 1px;
    animation: musicBarJump 1.2s ease-in-out infinite alternate;
  }

  .music-bars-anim .b1 { height: 60%; animation-delay: 0.1s; }
  .music-bars-anim .b2 { height: 100%; animation-delay: 0.3s; }
  .music-bars-anim .b3 { height: 40%; animation-delay: 0.2s; }

  @keyframes musicBarJump {
    0% { height: 25%; }
    100% { height: 100%; }
  }

  .author-badge-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author-name-tag {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: #ffffff;
    font-weight: 600;
  }

  .author-sub-tag {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
  }

  .newsroom-content-column {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .newsroom-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .news-duration-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--accent-terracotta);
    display: block;
    margin-bottom: 0.4rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .news-role-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.35rem;
    color: var(--text-main);
  }

  .news-org-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .news-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .cadence-box {
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent-terracotta);
    border-radius: 4px;
    padding: 1.35rem 1.6rem;
  }

  .cadence-header {
    margin-bottom: 0.5rem;
  }

  .cadence-label {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--accent-terracotta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .cadence-text {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .competencies-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .competencies-heading {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
  }

  .competency-card {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .comp-icon {
    color: var(--accent-terracotta);
    font-size: 0.75rem;
  }

  /* Growth Milestones Grid */
  .growth-wrapper {
    margin-bottom: 4.5rem;
  }

  .growth-header {
    margin-bottom: 2rem;
  }

  .growth-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--accent-terracotta);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .growth-heading {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .growth-sub {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .growth-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .growth-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
  }

  .growth-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .growth-channel {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-terracotta);
  }

  .growth-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .growth-metric-val {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.1;
  }

  .growth-role {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .growth-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Skills Bento */
  .specializations-wrapper {
    margin-top: 2rem;
  }

  .spec-header {
    margin-bottom: 2rem;
  }

  .spec-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-terracotta);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .spec-heading {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .skills-bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .skill-bento-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 2rem;
  }

  .skill-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .skill-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-main);
  }

  .skill-type-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent-terracotta);
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .skill-description {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .skill-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
  }

  .skill-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  /* Mobile Responsive */
  @media (max-width: 1000px) {
    .newsroom-hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .author-portrait-frame {
      max-width: 360px;
      margin: 0 auto;
    }

    .growth-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .skills-bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .newsroom-hero {
      padding: 1.75rem 1.25rem;
    }

    .competencies-grid {
      grid-template-columns: 1fr;
    }

    .growth-grid {
      grid-template-columns: 1fr;
    }

    .skills-bento-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
