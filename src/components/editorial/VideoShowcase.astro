---
import { portfolioData } from '../../data/portfolioData';
import { getAssetUrl } from '../../utils/assets';

const { instagramChannels, personal } = portfolioData;
---

<section class="gallery-section" id="channels">
  <div class="section-number-tag">
    <span>EXHIBIT 01 // DIGITAL PUBLICATION CHANNELS & AUDIENCE REACH</span>
  </div>
  <h2 class="section-title">
    Editorial Channels & <span class="italic-serif">Audience Metrics</span>
  </h2>
  <p class="section-subtext">
    Ten active digital media channels engineered for high-retention visual storytelling, archival research depth, and rapid daily newsroom turnaround across 2M+ combined audience reach.
  </p>

  <!-- Instagram Publications Catalog Bento -->
  <div class="channel-catalog-wrapper">
    <div class="catalog-header">
      <div class="catalog-header-left">
        <span class="catalog-label">FEATURED PUBLICATION CHANNELS</span>
        <h3 class="catalog-title">Active Digital Portfolios & News Desks</h3>
      </div>
      <div class="catalog-header-contact">
        <span class="contact-hint">Pitch a story or commission editorial research:</span>
        <a href={personal.whatsapp} target="_blank" rel="noopener noreferrer" class="quick-wa-btn">
          <span>💬 WhatsApp {personal.phone}</span>
        </a>
      </div>
    </div>

    <div class="catalog-grid">
      {instagramChannels.map(ch => (
        <div class="gallery-card channel-exhibit-card">
          <div class="ch-top-row">
            <div class="ch-identity">
              {ch.logoImage ? (
                <div class="ch-logo-avatar">
                  <img 
                    src={getAssetUrl(ch.logoImage)} 
                    alt={`${ch.name} logo`} 
                    class="ch-avatar-img" 
                    loading="lazy" 
                    decoding="async"
                    width="44"
                    height="44"
                  />
                </div>
              ) : (
                <span class="ch-icon">📸</span>
              )}
              <div>
                <h4 class="ch-title">{ch.name}</h4>
                <a href={ch.url} target="_blank" rel="noopener noreferrer" class="ch-handle">{ch.handle} ↗</a>
              </div>
            </div>
            <span class="gallery-tag gold">{ch.badge}</span>
          </div>

          <div class="ch-niche-line">
            <span class="niche-title">NICHE:</span>
            <span class="niche-desc">{ch.niche}</span>
          </div>

          <p class="ch-summary">{ch.description}</p>

          <div class="ch-metrics-bar">
            <div class="m-stat">
              <span class="m-stat-num">{ch.followers}</span>
              <span class="m-stat-lbl">Followers</span>
            </div>
            <div class="m-stat">
              <span class="m-stat-num">{ch.totalViews}</span>
              <span class="m-stat-lbl">Reel Views</span>
            </div>
            <div class="m-stat">
              <span class="m-stat-num">{ch.avgLikes}</span>
              <span class="m-stat-lbl">Avg Likes</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Channels Catalog */
  .channel-catalog-wrapper {
    margin-top: 1rem;
  }

  .catalog-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .catalog-label {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--accent-terracotta);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .catalog-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 500;
    color: var(--text-main);
  }

  .catalog-header-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .contact-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .quick-wa-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    transition: all var(--speed-fast) var(--ease);
  }

  .quick-wa-btn:hover {
    background: #10b981;
    color: #ffffff;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .channel-exhibit-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--bg-surface);
  }

  .ch-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .ch-identity {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .ch-logo-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-surface-soft);
    border: 1.5px solid var(--hairline);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform var(--speed-fast) var(--ease), border-color var(--speed-fast) var(--ease);
  }

  .channel-exhibit-card:hover .ch-logo-avatar {
    transform: scale(1.08);
    border-color: var(--accent-terracotta);
  }

  .ch-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ch-icon {
    font-size: 1.35rem;
  }

  .ch-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.15rem;
    color: var(--text-main);
  }

  .ch-handle {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--accent-terracotta);
    text-decoration: none;
    border-bottom: 1px dotted rgba(194, 89, 58, 0.4);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    transition: all var(--speed-fast) var(--ease);
    outline: none;
  }

  .ch-handle:hover {
    color: var(--accent-terracotta);
    border-bottom: 1px solid var(--accent-terracotta);
    transform: translateX(1px);
  }

  .ch-handle:focus-visible {
    outline: 2px solid rgba(194, 89, 58, 0.4);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .ch-niche-line {
    font-size: 0.88rem;
    color: var(--text-secondary);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .niche-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    letter-spacing: 0.05em;
  }

  .ch-summary {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .ch-metrics-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline-subtle);
  }

  .m-stat {
    flex: 1;
    background: var(--bg-surface-soft);
    border: 1px solid var(--hairline);
    padding: 0.6rem 0.75rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .m-stat-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .m-stat-lbl {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  /* Mobile Responsiveness */
  @media (max-width: 1060px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .catalog-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .catalog-header-contact {
      align-items: flex-start;
      width: 100%;
    }

    .quick-wa-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 1rem;
    }

    .channel-exhibit-card {
      padding: 1.25rem 1rem;
    }

    .ch-metrics-bar {
      gap: 0.4rem;
    }

    .m-stat {
      padding: 0.45rem 0.35rem;
    }

    .m-stat-num {
      font-size: 1.1rem;
    }

    .m-stat-lbl {
      font-size: 0.625rem;
    }
  }
</style>
