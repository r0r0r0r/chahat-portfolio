<script>
  const heroCopyBtn = document.getElementById('hero-copy-email-btn');
  const heroCopyText = document.getElementById('hero-copy-text');

  if (heroCopyBtn && heroCopyText) {
    heroCopyBtn.addEventListener('click', async () => {
      const email = heroCopyBtn.getAttribute('data-email') || '';
      try {
        await navigator.clipboard.writeText(email);
        heroCopyText.textContent = '✓ copied';
        setTimeout(() => {
          heroCopyText.textContent = 'copy email';
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  // Dossier Video Sound Toggle
  const dossierVideo = document.getElementById('hero-dossier-video-el') as HTMLVideoElement | null;
  const soundBtn = document.getElementById('dossier-video-sound-btn');
  const soundIcon = document.getElementById('dossier-sound-icon');

  if (dossierVideo && soundBtn && soundIcon) {
    soundBtn.addEventListener('click', () => {
      dossierVideo.muted = !dossierVideo.muted;
      soundIcon.textContent = dossierVideo.muted ? '🔇' : '🔊';
    });
  }
</script>
